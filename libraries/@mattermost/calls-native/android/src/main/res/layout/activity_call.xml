<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Status line: phone icon + label.
         Texts switch between "Incoming voice call", "Connecting…",
         "Connected", and "Call failed" in code.

         The label is the visually-centered element (constrained to parent
         start/end) so short strings like "Call failed" don't appear off-center
         because of the icon to their left. The icon hangs off the label's
         start edge. paddingHorizontal on the label leaves room for the icon
         on either side regardless of locale text direction. -->
    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="72dp"
        android:src="@drawable/ic_call_up"
        app:tint="@color/call_green"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/status_label"
        app:layout_constraintBottom_toBottomOf="@id/status_label"
        app:layout_constraintEnd_toStartOf="@id/status_label"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:textColor="@color/call_green"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Incoming voice call"
        android:text="@string/mobile_android_calls_incoming_voice_call"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#A8C0DA"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="00:42"
        app:layout_constraintTop_toBottomOf="@id/status_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Avatar block centered between status row (top) and caller_name (bottom).
         Vertical chain with bias keeps it visually anchored at ~38% of the screen. -->
    <FrameLayout
        android:id="@+id/avatar_frame"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/status_label"
        app:layout_constraintBottom_toTopOf="@id/caller_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/avatar_glow"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/glow_answer"
            android:alpha="0.6"
            android:contentDescription="@null" />

        <View
            android:id="@+id/avatar_ring_static"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_ring" />

        <View
            android:id="@+id/avatar_ring_rotating"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_ring_rotating"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/caller_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="24dp"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Alex Johnson"
        app:layout_constraintTop_toBottomOf="@id/avatar_frame"
        app:layout_constraintBottom_toTopOf="@id/action_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Horizontal barrier the action rows sit below. Lets us stack both
         incoming and active rows in the same XML without one influencing
         the other's vertical position. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/action_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="incoming_actions,active_actions" />

    <!-- Incoming-state actions: Decline + Answer.
         Pinned to the bottom; bias keeps them up off the gesture bar. -->
    <LinearLayout
        android:id="@+id/incoming_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/decline_stack"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/decline_glow"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/glow_decline"
                    android:alpha="0.6"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_decline_outer_ring" />

                <FrameLayout
                    android:id="@+id/decline_button"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_decline_inner_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/mobile_android_calls_decline">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call_down"
                        android:contentDescription="@null"
                        app:tint="@color/call_red" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mobile_android_calls_decline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/answer_stack"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/answer_glow"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/glow_answer"
                    android:alpha="0.6"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_answer_outer_ring" />

                <FrameLayout
                    android:id="@+id/answer_button"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_answer_inner_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/mobile_android_calls_answer">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call_up"
                        android:contentDescription="@null"
                        app:tint="@color/call_green" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mobile_android_calls_answer" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active-state controls: Mute + Hang Up (visible after answer) -->
    <LinearLayout
        android:id="@+id/active_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingHorizontal="56dp"
        android:layout_marginBottom="96dp"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/mute_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_control"
                android:src="@drawable/ic_mic"
                android:scaleType="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/mobile_android_calls_mute" />

            <TextView
                android:id="@+id/mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#A8C0DA"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mobile_android_calls_mute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/hangup_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_decline"
                android:src="@drawable/ic_call_down"
                android:scaleType="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/mobile_android_calls_hang_up" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#A8C0DA"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mobile_android_calls_hang_up" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
