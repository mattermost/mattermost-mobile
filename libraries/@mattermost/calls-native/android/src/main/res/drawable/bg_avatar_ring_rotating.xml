<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="360">
    <shape android:shape="oval">
        <stroke
            android:width="2dp"
            android:color="#22D85B" />
        <gradient
            android:type="sweep"
            android:startColor="#0022D85B"
            android:centerColor="#7022D85B"
            android:endColor="#22D85B" />
    </shape>
</rotate>
