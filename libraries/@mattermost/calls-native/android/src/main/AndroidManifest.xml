<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Calls foreground service: keeps the microphone alive while a call is
         active and hosts the phone-style incoming/ongoing call notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- androidx.core.telecom uses self-managed Telecom under the hood. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application>
        <service
            android:name="com.mattermost.callsnative.services.MMCallsForegroundService"
            android:foregroundServiceType="phoneCall|microphone"
            android:exported="false" />

        <service
            android:name="com.mattermost.callsnative.services.MMCallsBootTaskService"
            android:exported="false" />

        <receiver
            android:name="com.mattermost.callsnative.receivers.HangupReceiver"
            android:exported="false" />

        <receiver
            android:name="com.mattermost.callsnative.receivers.MuteReceiver"
            android:exported="false" />

        <receiver
            android:name="com.mattermost.callsnative.receivers.AnswerReceiver"
            android:exported="false" />

        <receiver
            android:name="com.mattermost.callsnative.receivers.DeclineReceiver"
            android:exported="false" />

        <activity
            android:name="com.mattermost.callsnative.ui.CallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MMCallsNative.CallActivity"
            tools:targetApi="27" />
    </application>
</manifest>
