+package com.mattermost.networkclient.helpers
+
+import android.content.Context
+import android.net.Uri
+import android.util.AtomicFile
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+import java.security.cert.CertificateException
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+
+class ServerCertificateException(val code: String, message: String) : Exception(message)
+
+data class StoredServerCertificate(
+    val host: String,
+    val fileName: String,
+    val certificate: X509Certificate,
+)
+
+/**
+ * Application-private CA certificates imported for Mattermost servers.
+ *
+ * Only validated certificate bytes are persisted. The original document, which could
+ * accidentally contain other PEM blocks, is never copied into application storage.
+ */
+object ServerCertificateStore {
+    private const val DIRECTORY_NAME = "server_ca_certificates"
+    private const val PREFERENCES_NAME = "ServerCertificateStore"
+    private const val FILE_NAME_PREFIX = "file_name:"
+    private const val DEFAULT_FILE_NAME = "cert.crt"
+    private const val MAX_CERTIFICATE_BYTES = 64 * 1024
+
+    @Volatile
+    private var generation = 0
+
+    private val cacheLock = Any()
+    private var cachedGeneration = -1
+    private var cachedCertificates: List<X509Certificate> = emptyList()
+
+    @Synchronized
+    fun importCertificate(
+        context: Context,
+        serverUrl: String,
+        uri: String,
+        requestedFileName: String?,
+    ): StoredServerCertificate {
+        val appContext = context.applicationContext
+        val host = serverHost(serverUrl)
+        val bytes = readDocument(appContext, uri)
+        val certificate = parseCertificate(bytes)
+        val fileName = safeFileName(requestedFileName)
+
+        try {
+            writeCertificate(certificateFile(appContext, host), certificate.encoded)
+            val saved = preferences(appContext)
+                .edit()
+                .putString(FILE_NAME_PREFIX + hostKey(host), fileName)
+                .commit()
+            if (!saved) {
+                certificateFile(appContext, host).delete()
+                throw ServerCertificateException(
+                    "E_CERTIFICATE_STORAGE",
+                    "The certificate could not be saved in application storage.",
+                )
+            }
+        } catch (error: ServerCertificateException) {
+            throw error
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_STORAGE",
+                "The certificate could not be saved in application storage.",
+            )
+        }
+
+        generation += 1
+        return StoredServerCertificate(host, fileName, certificate)
+    }
+
+    @Synchronized
+    fun getCertificate(context: Context, serverUrl: String): StoredServerCertificate? {
+        val appContext = context.applicationContext
+        val host = serverHost(serverUrl)
+        val file = certificateFile(appContext, host)
+        if (!file.isFile) return null
+
+        val certificate = try {
+            readCertificate(file)
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_READ",
+                "The saved certificate could not be read. Import it again.",
+            )
+        }
+        val fileName = preferences(appContext)
+            .getString(FILE_NAME_PREFIX + hostKey(host), DEFAULT_FILE_NAME)
+            ?: DEFAULT_FILE_NAME
+        return StoredServerCertificate(host, fileName, certificate)
+    }
+
+    @Synchronized
+    fun removeCertificate(context: Context, serverUrl: String): Boolean {
+        val appContext = context.applicationContext
+        val host = serverHost(serverUrl)
+        val file = certificateFile(appContext, host)
+        val existed = file.isFile
+        try {
+            if (existed && !file.delete()) {
+                throw IOException("Could not delete certificate")
+            }
+            val saved = preferences(appContext)
+                .edit()
+                .remove(FILE_NAME_PREFIX + hostKey(host))
+                .commit()
+            if (!saved) throw IOException("Could not update certificate metadata")
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_STORAGE",
+                "The certificate could not be removed. Try again.",
+            )
+        }
+
+        if (existed) generation += 1
+        return existed
+    }
+
+    /** Moves the management association after a server URL or redirect changes hostname. */
+    @Synchronized
+    fun reassignCertificate(
+        context: Context,
+        previousServerUrl: String,
+        newServerUrl: String,
+    ): StoredServerCertificate {
+        val appContext = context.applicationContext
+        val previousHost = serverHost(previousServerUrl)
+        val newHost = serverHost(newServerUrl)
+        val previous = getCertificate(appContext, previousServerUrl)
+            ?: throw ServerCertificateException(
+                "E_CERTIFICATE_NOT_FOUND",
+                "The previously imported certificate is no longer available.",
+            )
+        if (previousHost == newHost) return previous
+
+        try {
+            writeCertificate(certificateFile(appContext, newHost), previous.certificate.encoded)
+            val previousKey = hostKey(previousHost)
+            val newKey = hostKey(newHost)
+            val saved = preferences(appContext)
+                .edit()
+                .putString(FILE_NAME_PREFIX + newKey, previous.fileName)
+                .remove(FILE_NAME_PREFIX + previousKey)
+                .commit()
+            if (!saved) throw IOException("Could not update certificate metadata")
+            if (!certificateFile(appContext, previousHost).delete()) {
+                throw IOException("Could not remove previous certificate association")
+            }
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_STORAGE",
+                "The certificate could not be associated with the connected server.",
+            )
+        }
+
+        generation += 1
+        return StoredServerCertificate(newHost, previous.fileName, previous.certificate)
+    }
+
+    /** Returns a stable cached list until the store changes or a certificate expires. */
+    fun getTrustedCertificates(context: Context): List<X509Certificate> {
+        val appContext = context.applicationContext
+        synchronized(cacheLock) {
+            while (true) {
+                val loadingGeneration = generation
+                if (cachedGeneration != loadingGeneration) {
+                    val certificates = directory(appContext).listFiles()
+                        ?.filter { it.isFile && it.name.endsWith(".der") }
+                        ?.mapNotNull { file ->
+                            try {
+                                readCertificate(file)
+                            } catch (_: Exception) {
+                                // A damaged or expired entry is never used as a trust anchor.
+                                null
+                            }
+                        }
+                        .orEmpty()
+
+                    // An import may finish while the directory is being read. Retry instead of
+                    // marking a potentially stale list as belonging to the new generation.
+                    if (loadingGeneration == generation) {
+                        cachedCertificates = certificates
+                        cachedGeneration = loadingGeneration
+                    }
+                    continue
+                }
+
+                val validCertificates = cachedCertificates.filter { certificate ->
+                    try {
+                        certificate.checkValidity()
+                        true
+                    } catch (_: CertificateException) {
+                        false
+                    }
+                }
+                if (validCertificates.size != cachedCertificates.size) {
+                    cachedCertificates = validCertificates
+                }
+                if (loadingGeneration == generation) return cachedCertificates
+            }
+        }
+    }
+
+    fun parseCertificate(bytes: ByteArray): X509Certificate {
+        if (bytes.isEmpty()) {
+            throw ServerCertificateException("E_CERTIFICATE_INVALID", "The selected certificate file is empty.")
+        }
+
+        val certificate = try {
+            val parsed = CertificateFactory.getInstance("X.509")
+                .generateCertificates(bytes.inputStream())
+            if (parsed.size != 1) {
+                throw ServerCertificateException(
+                    "E_CERTIFICATE_INVALID",
+                    "Select a file containing exactly one X.509 CA certificate.",
+                )
+            }
+            parsed.single() as X509Certificate
+        } catch (error: ServerCertificateException) {
+            throw error
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_INVALID",
+                "The selected file is not a valid PEM or DER X.509 certificate.",
+            )
+        }
+
+        if (certificate.basicConstraints < 0) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_NOT_CA",
+                "The selected certificate is not a CA certificate. Choose the issuing root CA.",
+            )
+        }
+
+        try {
+            certificate.checkValidity()
+        } catch (_: CertificateException) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_INVALID",
+                "The selected CA certificate is expired or is not valid yet.",
+            )
+        }
+        return certificate
+    }
+
+    fun fingerprint(certificate: X509Certificate): String {
+        return MessageDigest.getInstance("SHA-256")
+            .digest(certificate.encoded)
+            .joinToString(":") { "%02X".format(it) }
+    }
+
+    private fun serverHost(serverUrl: String): String {
+        val parsed = serverUrl.toHttpUrlOrNull() ?: throw ServerCertificateException(
+            "E_CERTIFICATE_SERVER_URL",
+            "Enter a valid server URL before importing a certificate.",
+        )
+        return parsed.host
+    }
+
+    private fun readDocument(context: Context, uri: String): ByteArray {
+        try {
+            val input = context.contentResolver.openInputStream(Uri.parse(uri))
+                ?: throw IOException("Document provider returned no stream")
+            return input.use { stream ->
+                val output = ByteArrayOutputStream()
+                val buffer = ByteArray(8192)
+                while (true) {
+                    val count = stream.read(buffer)
+                    if (count < 0) break
+                    if (output.size() + count > MAX_CERTIFICATE_BYTES) {
+                        throw ServerCertificateException(
+                            "E_CERTIFICATE_INVALID",
+                            "The certificate file is too large. Choose a PEM or DER file no larger than 64 KB.",
+                        )
+                    }
+                    output.write(buffer, 0, count)
+                }
+                output.toByteArray()
+            }
+        } catch (error: ServerCertificateException) {
+            throw error
+        } catch (_: Exception) {
+            throw ServerCertificateException(
+                "E_CERTIFICATE_READ",
+                "The selected certificate file could not be read.",
+            )
+        }
+    }
+
+    private fun readCertificate(file: File): X509Certificate {
+        val bytes = file.inputStream().use { input ->
+            if (file.length() > MAX_CERTIFICATE_BYTES) throw IOException("Certificate too large")
+            input.readBytes()
+        }
+        return parseCertificate(bytes)
+    }
+
+    private fun writeCertificate(file: File, bytes: ByteArray) {
+        file.parentFile?.let { parent ->
+            if (!parent.isDirectory && !parent.mkdirs()) throw IOException("Could not create certificate directory")
+        }
+        val atomicFile = AtomicFile(file)
+        var output: FileOutputStream? = null
+        try {
+            output = atomicFile.startWrite()
+            output.write(bytes)
+            atomicFile.finishWrite(output)
+            output = null
+        } catch (error: Exception) {
+            output?.let { atomicFile.failWrite(it) }
+            throw error
+        }
+    }
+
+    private fun safeFileName(fileName: String?): String {
+        val cleaned = fileName
+            ?.replace(Regex("[\\p{Cntrl}]"), "")
+            ?.trim()
+            ?.take(160)
+        return if (cleaned.isNullOrEmpty()) DEFAULT_FILE_NAME else cleaned
+    }
+
+    private fun preferences(context: Context) =
+        context.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+
+    private fun directory(context: Context) = File(context.filesDir, DIRECTORY_NAME)
+
+    private fun certificateFile(context: Context, host: String) =
+        File(directory(context), hostKey(host) + ".der")
+
+    private fun hostKey(host: String): String {
+        return MessageDigest.getInstance("SHA-256")
+            .digest(host.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+    }
+}
