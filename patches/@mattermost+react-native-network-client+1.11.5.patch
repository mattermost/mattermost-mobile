+package com.mattermost.networkclient.helpers
+
+import java.security.KeyStore
+import java.security.cert.CertificateException
+import java.security.cert.X509Certificate
+import javax.net.ssl.TrustManagerFactory
+import javax.net.ssl.X509TrustManager
+
+/**
+ * Uses the platform trust manager first and then ENCMA's application-private CAs.
+ * No certificate or hostname checks are bypassed.
+ */
+class ServerTrustManager(
+    private val platformTrustManager: X509TrustManager,
+    private val importedCertificatesProvider: () -> List<X509Certificate>,
+) : X509TrustManager {
+    @Volatile
+    private var importedCertificates: List<X509Certificate>? = null
+
+    @Volatile
+    private var importedTrustManager: X509TrustManager? = null
+
+    override fun checkClientTrusted(chain: Array<X509Certificate>, authType: String) {
+        try {
+            platformTrustManager.checkClientTrusted(chain, authType)
+            return
+        } catch (platformError: CertificateException) {
+            checkImportedClientTrusted(chain, authType, platformError)
+        }
+    }
+
+    override fun checkServerTrusted(chain: Array<X509Certificate>, authType: String) {
+        try {
+            platformTrustManager.checkServerTrusted(chain, authType)
+            return
+        } catch (platformError: CertificateException) {
+            checkImportedServerTrusted(chain, authType, platformError)
+        }
+    }
+
+    override fun getAcceptedIssuers(): Array<X509Certificate> {
+        val imported = currentImportedTrustManager()?.acceptedIssuers.orEmpty()
+        return platformTrustManager.acceptedIssuers + imported
+    }
+
+    private fun checkImportedClientTrusted(
+        chain: Array<X509Certificate>,
+        authType: String,
+        platformError: CertificateException,
+    ) {
+        val imported = currentImportedTrustManager() ?: throw platformError
+        try {
+            imported.checkClientTrusted(chain, authType)
+        } catch (importedError: CertificateException) {
+            importedError.addSuppressed(platformError)
+            throw importedError
+        }
+    }
+
+    private fun checkImportedServerTrusted(
+        chain: Array<X509Certificate>,
+        authType: String,
+        platformError: CertificateException,
+    ) {
+        val imported = currentImportedTrustManager() ?: throw platformError
+        try {
+            imported.checkServerTrusted(chain, authType)
+        } catch (importedError: CertificateException) {
+            importedError.addSuppressed(platformError)
+            throw importedError
+        }
+    }
+
+    @Synchronized
+    private fun currentImportedTrustManager(): X509TrustManager? {
+        val certificates = importedCertificatesProvider()
+        if (certificates === importedCertificates) return importedTrustManager
+
+        importedCertificates = certificates
+        importedTrustManager = if (certificates.isEmpty()) {
+            null
+        } else {
+            val keyStore = KeyStore.getInstance(KeyStore.getDefaultType()).apply {
+                load(null)
+                certificates.forEachIndexed { index, certificate ->
+                    setCertificateEntry("encma-imported-$index", certificate)
+                }
+            }
+            TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm()).run {
+                init(keyStore)
+                trustManagers.filterIsInstance<X509TrustManager>().first()
+            }
+        }
+        return importedTrustManager
+    }
+}
