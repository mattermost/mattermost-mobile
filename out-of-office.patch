@@ -0,0 +1,202 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import moment, {type Moment} from 'moment-timezone';
+import React, {useCallback, useEffect, useState} from 'react';
+import {defineMessages, useIntl} from 'react-intl';
+import {Text, View} from 'react-native';
+
+import Button from '@components/button';
+import DateTimeSelector from '@components/date_time_selector/date_time_selector';
+import FormattedText from '@components/formatted_text';
+import SettingContainer from '@components/settings/container';
+import SettingOption from '@components/settings/option';
+import {Screens} from '@constants';
+import {useServerUrl} from '@context/server';
+import {useTheme} from '@context/theme';
+import useAndroidHardwareBackHandler from '@hooks/android_back_handler';
+import {usePreventDoubleTap} from '@hooks/utils';
+import {navigateBack} from '@screens/navigation';
+import {getOutOfOfficeSettings, saveOutOfOfficeSettings, type OutOfOfficeSettings} from '@utils/out_of_office';
+import {makeStyleSheetFromTheme} from '@utils/theme';
+import {typography} from '@utils/typography';
+
+const messages = defineMessages({
+    enable: {id: 'out_of_office.enable', defaultMessage: 'Schedule out of office'},
+    description: {id: 'out_of_office.description', defaultMessage: 'Pause notifications on this device for this server during the scheduled period. Notifications resume automatically when it ends. Exceptions only allow notifications already enabled in your notification settings. On iOS, silent notifications may still appear and a call may briefly appear on screen. Mention exceptions require server support.'},
+    start: {id: 'out_of_office.start', defaultMessage: 'Starts'},
+    end: {id: 'out_of_office.end', defaultMessage: 'Ends'},
+    timezone: {id: 'out_of_office.timezone', defaultMessage: 'Times use your device timezone: {timezone}.'},
+    calls: {id: 'out_of_office.allow_calls', defaultMessage: 'Allow calls during out of office'},
+    mentions: {id: 'out_of_office.allow_mentions', defaultMessage: 'Allow mentions during out of office'},
+    invalid: {id: 'out_of_office.invalid_period', defaultMessage: 'Choose an end time after the start time and later than now.'},
+    loadError: {id: 'out_of_office.load_error', defaultMessage: 'Unable to load your out of office settings. Go back and try again.'},
+    saveError: {id: 'out_of_office.save_error', defaultMessage: 'Unable to save your out of office settings. Please try again.'},
+});
+
+const ONE_DAY = 24 * 60 * 60 * 1000;
+
+function getDefaultSettings(): OutOfOfficeSettings {
+    const startAt = Date.now();
+    return {enabled: false, startAt, endAt: startAt + ONE_DAY, allowCalls: false, allowMentions: false};
+}
+
+const getStyleSheet = makeStyleSheetFromTheme((theme: Theme) => ({
+    container: {gap: 16, paddingBottom: 24},
+    text: {color: theme.centerChannelColor, ...typography('Body', 100, 'Regular')},
+    label: {color: theme.centerChannelColor, ...typography('Body', 200, 'SemiBold')},
+    error: {color: theme.errorTextColor, ...typography('Body', 100, 'Regular')},
+}));
+
+export default function OutOfOffice() {
+    const intl = useIntl();
+    const serverUrl = useServerUrl();
+    const theme = useTheme();
+    const styles = getStyleSheet(theme);
+    const [timezone] = useState(() => moment.tz.guess());
+    const [settings, setSettings] = useState<OutOfOfficeSettings>(getDefaultSettings);
+    const [loading, setLoading] = useState(true);
+    const [saving, setSaving] = useState(false);
+    const [error, setError] = useState('');
+    const [loadFailed, setLoadFailed] = useState(false);
+
+    useEffect(() => {
+        let active = true;
+        setLoading(true);
+        setSettings(getDefaultSettings());
+        setLoadFailed(false);
+        setError('');
+        getOutOfOfficeSettings(serverUrl).then((saved) => {
+            if (active && saved) {
+                setSettings(saved);
+            }
+        }).catch(() => {
+            if (active) {
+                setLoadFailed(true);
+                setError(intl.formatMessage(messages.loadError));
+            }
+        }).finally(() => {
+            if (active) {
+                setLoading(false);
+            }
+        });
+        return () => {
+            active = false;
+        };
+    }, [serverUrl, intl]);
+
+    useAndroidHardwareBackHandler(Screens.SETTINGS_OUT_OF_OFFICE, navigateBack);
+
+    const setEnabled = useCallback((enabled: boolean) => setSettings((previous) => ({...previous, enabled})), []);
+    const setAllowCalls = useCallback((allowCalls: boolean) => setSettings((previous) => ({...previous, allowCalls})), []);
+    const setAllowMentions = useCallback((allowMentions: boolean) => setSettings((previous) => ({...previous, allowMentions})), []);
+    const setStart = useCallback((date: Moment) => setSettings((previous) => ({...previous, startAt: date.valueOf()})), []);
+    const setEnd = useCallback((date: Moment) => setSettings((previous) => ({...previous, endAt: date.valueOf()})), []);
+
+    const save = useCallback(async () => {
+        if (loading || saving || loadFailed) {
+            return;
+        }
+        if (settings.enabled && (settings.endAt <= settings.startAt || settings.endAt <= Date.now())) {
+            setError(intl.formatMessage(messages.invalid));
+            return;
+        }
+        setSaving(true);
+        setError('');
+        try {
+            await saveOutOfOfficeSettings(serverUrl, settings);
+            navigateBack();
+        } catch {
+            setError(intl.formatMessage(messages.saveError));
+        } finally {
+            setSaving(false);
+        }
+    }, [loading, saving, loadFailed, settings, intl, serverUrl]);
+
+    const onSave = usePreventDoubleTap(save);
+
+    return (
+        <SettingContainer testID='out_of_office_settings'>
+            <View style={styles.container}>
+                <FormattedText
+                    id={messages.description.id}
+                    defaultMessage={messages.description.defaultMessage}
+                    style={styles.text}
+                />
+                {!loading && !loadFailed && !saving && (
+                    <>
+                        <SettingOption
+                            type='toggle'
+                            label={intl.formatMessage(messages.enable)}
+                            selected={settings.enabled}
+                            action={setEnabled}
+                            testID='out_of_office_settings.enable'
+                        />
+                        {settings.enabled && (
+                            <>
+                                <Text style={styles.text}>{intl.formatMessage(messages.timezone, {timezone})}</Text>
+                                <Text style={styles.label}>
+                                    {intl.formatMessage(messages.start)}{': '}{intl.formatDate(settings.startAt, {dateStyle: 'medium', timeStyle: 'short', timeZone: timezone})}
+                                </Text>
+                                <DateTimeSelector
+                                    initialDate={moment(settings.startAt)}
+                                    handleChange={setStart}
+                                    timezone={timezone}
+                                    isMilitaryTime={false}
+                                    theme={theme}
+                                    minuteInterval={1}
+                                    allowPastDates={true}
+                                    testID='out_of_office_settings.start'
+                                />
+                                <Text style={styles.label}>
+                                    {intl.formatMessage(messages.end)}{': '}{intl.formatDate(settings.endAt, {dateStyle: 'medium', timeStyle: 'short', timeZone: timezone})}
+                                </Text>
+                                <DateTimeSelector
+                                    initialDate={moment(settings.endAt)}
+                                    handleChange={setEnd}
+                                    timezone={timezone}
+                                    isMilitaryTime={false}
+                                    theme={theme}
+                                    minuteInterval={1}
+                                    allowPastDates={true}
+                                    testID='out_of_office_settings.end'
+                                />
+                                <SettingOption
+                                    type='toggle'
+                                    label={intl.formatMessage(messages.calls)}
+                                    selected={settings.allowCalls}
+                                    action={setAllowCalls}
+                                    testID='out_of_office_settings.allow_calls'
+                                />
+                                <SettingOption
+                                    type='toggle'
+                                    label={intl.formatMessage(messages.mentions)}
+                                    selected={settings.allowMentions}
+                                    action={setAllowMentions}
+                                    testID='out_of_office_settings.allow_mentions'
+                                />
+                            </>
+                        )}
+                    </>
+                )}
+                {Boolean(error) && (
+                    <Text
+                        accessibilityRole='alert'
+                        style={styles.error}
+                        testID='out_of_office_settings.error'
+                    >
+                        {error}
+                    </Text>
+                )}
+                <Button
+                    theme={theme}
+                    text={intl.formatMessage({id: 'settings.save', defaultMessage: 'Save'})}
+                    onPress={onSave}
+                    disabled={loading || saving || loadFailed}
+                    showLoader={loading || saving}
+                    testID='out_of_office_settings.save'
+                />
+            </View>
+        </SettingContainer>
+    );
+}
